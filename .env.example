# Server (copy to server/.env)
PORT=4000
# Comma-separated client origin(s); set to your Vercel client URL in production
CORS_ORIGIN=http://localhost:5173

# Client (copy to client/.env)
# API origin (no trailing slash) — your Vercel server deployment URL in production
VITE_API_URL=http://localhost:4000

# Zest payment SDK (add when integrating — never commit real keys)
# VITE_ZEST_PUBLIC_KEY=
